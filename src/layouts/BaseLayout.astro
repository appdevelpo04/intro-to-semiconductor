---
// Shared shell. The page title/description are injected by each page via
// <Fragment slot="head">-style props (see flow.astro); the defaults here are
// the Au | MoS₂ demo so `/` is unchanged.
const {
  title = 'Au | MoS₂ Schottky Contact — Band Alignment',
  description = 'Au | MoS₂ Schottky contact — band alignment and I–V characteristic.',
  /* Which section the nav should mark active on first paint. The nav also
     scroll-spies, so this is only the no-JS / pre-scroll default. */
  section = 'alignment',
} = Astro.props;
import '../styles/global.css';
import SectionNav from '../components/SectionNav.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='18' fill='%23070b17'/><path d='M22 55 L50 28 L78 55 L50 82 Z' fill='none' stroke='%2300e5b0' stroke-width='8'/></svg>" />
  </head>
  <body>
    <SectionNav current={section} />
    <div class="app">
      <slot />
    </div>
  </body>
</html>
