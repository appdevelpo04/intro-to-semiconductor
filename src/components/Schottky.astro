---
// Schottky contact interactive demo — two panels:
//   LEFT  : band-alignment canvas (Au | MoS₂)
//   RIGHT : I–V graph canvas + sliders + status + legend
---
<section class="schottky" id="alignment">
  <header class="topbar">
    <div>
      <h1>Au | MoS₂ Schottky Contact — Band Alignment</h1>
      <p class="sub">2H semiconducting phase · ideal n-type contact</p>
    </div>
    <div class="formula">
      <span data-tex="\Phi_B = \Phi_m - \chi_s"></span>
      <small>&nbsp; (n-type, ideal)</small>
    </div>
  </header>

  <div class="main">
    <!-- LEFT: band-alignment plot -->
    <section class="panel-plot">
      <div class="panel-header">
        <h2>Band alignment <span class="muted">(energy vs. position)</span></h2>
        <button class="btn-ghost contact-btn" id="contactToggle" type="button">Make contact</button>
      </div>
      <div class="panel-body">
        <div class="canvas-wrap" id="plotWrap">
          <canvas id="bandCanvas" aria-label="Band alignment diagram of Au and MoS₂"></canvas>
          <!-- Anchored by main.js onto the f(E) Fermi–Dirac inset (bottom-left of the
               band diagram). Click → hero modal with the magnified distribution. -->
          <button class="fermi-btn" id="fermiBtn" type="button"
                  aria-label="Magnify the Fermi-Dirac distribution f(E)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <path d="M21 21l-4.3-4.3"/>
              <path d="M11 8v6M8 11h6"/>
            </svg>
            <div>Magnify <span data-tex="f(E)"></span></div>
            <span class="fermi-btn-key">⤢</span>
          </button>
        </div>
        <div class="detail-panel" id="detailPanel" role="dialog" aria-label="Parameter detail">
          <button class="d-close" id="detailClose" type="button" aria-label="Close detail">×</button>
          <div class="d-title" id="detailTitle">Parameter</div>
          <div class="d-body" id="detailBody"></div>
        </div>
        <div class="legend" id="legendItems">
          <button class="legend-close" id="legendClose" type="button" aria-label="Dismiss legend">×</button>
          <div class="legend-pane" id="legendPaneBasic" role="tabpanel" aria-label="Beginner legend">
            <!-- items injected by main.js buildLegend() — injecting keeps the
                 click→detail wiring on every item (static copies had none) -->
          </div>
          <div class="legend-pane legend-pane-nerd" id="legendPaneNerd" role="tabpanel"
               aria-label="Formulas" hidden>
            <div class="nerd-row"><code data-tex="\Phi_B = \Phi_m - \chi_s"></code><span data-md="Schottky–Mott rule: n-type barrier height. Ohmic when $\Phi_B \le 0$."></span></div>
            <div class="nerd-row"><code data-tex="I = A\,A^{*}T^{2}\,e^{-\Phi_B/kT}\left(e^{qV/kT} - 1\right)"></code><span data-md="Thermionic-emission diode law; $A^{*}$ = Richardson constant."></span></div>
            <div class="nerd-row"><code data-tex="I_s = A\,A^{*}T^{2}\,e^{-q\Phi_B/kT}"></code><span data-md="Reverse saturation current — doubling $T$ or shrinking $\Phi_B$ blows it up."></span></div>
            <div class="nerd-row"><code data-tex="V_{bi} = \Phi_B - (E_C - E_F)/q"></code><span data-md="Built-in potential: barrier minus the doping offset in the bulk."></span></div>
            <div class="nerd-row"><code data-tex="W = \sqrt{2\varepsilon_s V_{bi} / (q\,N_D)}"></code><span data-md="Depletion width — doping-dependent space-charge region."></span></div>
            <div class="nerd-row"><code data-tex="E_g = E_C - E_V"></code><span data-md="Band gap; $f(E) = 1/(1 + e^{(E - E_F)/kT})$ fills states thermally."></span></div>
            <div class="nerd-row nerd-note" data-md="Real contacts deviate from Schottky–Mott: interface states pin $E_F$ (Bardeen limit), and the image force lowers the barrier by $\Delta\Phi = \sqrt{qE/(4\pi\varepsilon_s)}$."></div>
          </div>
          <!-- tabs share the tip's row so the legend never grows taller than the
               pre-tabs layout (it overlays the band diagram — every px counts) -->
          <div class="legend-foot">
            <div class="legend-tabs" role="tablist" aria-label="Legend detail level">
              <button class="legend-tab active" id="legendTabBasic" type="button" role="tab"
                      aria-selected="true" aria-controls="legendPaneBasic"
                      title="Beginner — labeled quantities">👶</button>
              <button class="legend-tab" id="legendTabNerd" type="button" role="tab"
                      aria-selected="false" aria-controls="legendPaneNerd"
                      title="Nerd — formulas & physics (Schottky barrier)">🤓</button>
            </div>
            <div class="legend-tip">Click any numbered arrow on the band diagram for the formula and value.</div>
          </div>
        </div>
        <button class="legend-restore" id="legendRestore" type="button" aria-label="Show legend" hidden>
          <span class="legend-restore-icon">⌃</span> Show legend
        </button>
      </div>
    </section>

    <!-- RIGHT: I–V graph + controls -->
    <section class="panel-graph">
      <div class="panel-header">
        <h2>I–V characteristic <span class="muted">(thermionic emission)</span></h2>
      </div>
      <div class="panel-body">
        <div class="canvas-wrap" id="graphWrap">
          <canvas id="graphCanvas" aria-label="Current–voltage characteristic of the Schottky diode"></canvas>
        </div>
      </div>

      <div class="controls" id="controls"></div>

      <div class="status" id="statusBar"></div>
    </section>
  </div>
</section>

<script>
  // Astro-processed script: bundled+hashed at build time, served as module in dev.
  // main.js imports render.js itself, so one entry point is enough.
  import '../assets/js/main.js';
</script>
