---
// Schottky contact interactive demo — two panels:
//   LEFT  : band-alignment canvas (Au | MoS₂)
//   RIGHT : I–V graph canvas + sliders + status + legend
---
<section class="schottky">
  <header class="topbar">
    <div>
      <h1>Au | MoS₂ Schottky Contact — Band Alignment</h1>
      <p class="sub">2H semiconducting phase · ideal n-type contact</p>
    </div>
    <div class="formula">
      Φ<sub>B</sub> = Φ<sub>m</sub> − χ<sub>s</sub>
      <small>&nbsp; (n-type, ideal)</small>
    </div>
  </header>

  <div class="main">
    <!-- LEFT: band-alignment plot -->
    <section class="panel-plot">
      <div class="panel-header">
        <h2>Band alignment <span class="muted">(energy vs. position)</span></h2>
        <button class="btn-ghost contact-btn" id="contactToggle" type="button">Make contact</button>
      </div>
      <div class="panel-body">
        <div class="canvas-wrap" id="plotWrap">
          <canvas id="bandCanvas" aria-label="Band alignment diagram of Au and MoS₂"></canvas>
          <!-- Anchored by main.js onto the f(E) Fermi–Dirac inset (bottom-left of the
               band diagram). Click → hero modal with the magnified distribution. -->
          <button class="fermi-btn" id="fermiBtn" type="button"
                  aria-label="Magnify the Fermi-Dirac distribution f(E)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <path d="M21 21l-4.3-4.3"/>
              <path d="M11 8v6M8 11h6"/>
            </svg>
            <span>Magnify f(E)</span>
            <span class="fermi-btn-key">⤢</span>
          </button>
        </div>
        <div class="detail-panel" id="detailPanel" role="dialog" aria-label="Parameter detail">
          <button class="d-close" id="detailClose" type="button" aria-label="Close detail">×</button>
          <div class="d-title" id="detailTitle">Parameter</div>
          <div class="d-body" id="detailBody"></div>
        </div>
        <div class="legend" id="legendItems">
          <button class="legend-close" id="legendClose" type="button" aria-label="Dismiss legend">×</button>
          <span class="legend-item" data-id="phi_m">Φ_m = metal work function</span>
          <span class="legend-item" data-id="chi_s">χ_s = electron affinity</span>
          <span class="legend-item" data-id="dE">E_F − E_C (doping)</span>
          <span class="legend-item" data-id="barrier">Φ_B = Φ_m − χ_s (barrier)</span>
          <span class="legend-item" data-id="vbi">Built-in potential V_bi</span>
          <span class="legend-item" data-id="eg">Band gap E_g</span>
          <span class="legend-item" data-id="efsep">Fermi offset before contact</span>
          <span class="legend-item" data-id="vacuum">vacuum level</span>
          <div class="legend-tip">Click any numbered arrow on the band diagram for the formula and value.</div>
        </div>
         <button class="legend-restore" id="legendRestore" type="button" aria-label="Show legend" hidden>
           <span class="legend-restore-icon">⌃</span> Show legend
         </button>
      </div>
    </section>

    <!-- RIGHT: I–V graph + controls -->
    <section class="panel-graph">
      <div class="panel-header">
        <h2>I–V characteristic <span class="muted">(thermionic emission)</span></h2>
      </div>
      <div class="panel-body">
        <div class="canvas-wrap" id="graphWrap">
          <canvas id="graphCanvas" aria-label="Current–voltage characteristic of the Schottky diode"></canvas>
        </div>
      </div>

      <div class="controls" id="controls"></div>

      <div class="status" id="statusBar"></div>
    </section>
  </div>
</section>

<script>
  // Astro-processed script: bundled+hashed at build time, served as module in dev.
  // main.js imports render.js itself, so one entry point is enough.
  import '../assets/js/main.js';
</script>
